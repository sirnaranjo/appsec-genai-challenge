# Cliente: servidor de análisis de docker compose
APPSEC_SERVER_URL=http://127.0.0.1:8001

# LLM
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Autenticacion
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
USUARIOS_PERMITIDOS=

# Integridad (en Docker se usan las rutas de docker-compose.yml)
RECEIPT_PRIVATE_KEY_PATH=keys/receipt_private.pem
DATABASE_PATH=data/appsec.db

# Opcional: réplica de Gitea a un repositorio de GitHub
GITHUB_ESPEJO_URL=
GITHUB_ESPEJO_TOKEN=
