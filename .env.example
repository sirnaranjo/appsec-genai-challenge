# Copiar como .env. Las variables vacías se completan; las demás tienen el valor por defecto

# Cliente: URL del servidor de análisis de docker compose
APPSEC_SERVER_URL=http://127.0.0.1:8001

# LLM: API key de Anthropic (obligatoria para analizar) y modelo
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Opcional. Esfuerzo del modelo: low, medium o high
ANTHROPIC_EFFORT=medium
# Opcional. Versión del prompt: nombre de un archivo de server/config/prompts
PROMPT_VERSION=security_review_v3
# Opcional. Severidad mínima que bloquea el commit: BAJA, MEDIA, ALTA o CRITICA
SEVERIDAD_BLOQUEO=MEDIA

# Autenticación: Client ID y client secret de la OAuth App de GitHub
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Usuarios de GitHub autorizados para el análisis, separados por coma. Vacío: no se autoriza a nadie
USUARIOS_PERMITIDOS=

# Integridad: solo se usan fuera de Docker; en Docker se usan las rutas de docker-compose.yml
RECEIPT_PRIVATE_KEY_PATH=keys/receipt_private.pem
DATABASE_PATH=data/appsec.db

# Opcional. Dirección de Gitea que usa scripts/configurar_gitea.py
GITEA_URL=http://localhost:3000

# Opcional: réplica de Gitea a un repositorio de GitHub nuevo y vacío, y un token con escritura solo sobre él.
# Si alguna está vacía, no se configura la réplica
GITHUB_ESPEJO_URL=
GITHUB_ESPEJO_TOKEN=
